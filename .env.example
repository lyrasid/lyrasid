# Chaves de API do "npm run adicionar" (busca de livros, filmes, séries e jogos para a
# estante). Copie este arquivo para ".env" (que fica de fora do git) e preencha as chaves.

# Livros (Open Library) não precisam de chave.

# Filmes e séries: cadastro grátis em https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# Jogos: cadastro grátis em https://rawg.io/apidocs
RAWG_API_KEY=
