<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  {% set tituloPagina %}{% if page.url != "/" %}{{ title }} · {% endif %}{{ site.nome }}{% endset %}
  <title>{{ tituloPagina }}</title>
  <meta property="og:type" content="website">
  <meta property="og:locale" content="pt_BR">
  <meta property="og:site_name" content="{{ site.nome }}">
  <meta property="og:title" content="{{ tituloPagina }}">
  <meta property="og:url" content="{{ urlSite }}{{ page.url }}">
  <meta property="og:image" content="{{ urlSite }}/assets/og.jpg">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="Página inicial do site {{ site.nome }}">
  <meta name="twitter:card" content="summary_large_image">
  <link rel="icon" type="image/png" sizes="32x32" href="/assets/favicon-32.png">
  <link rel="icon" type="image/png" sizes="192x192" href="/assets/favicon-192.png">
  <link rel="apple-touch-icon" href="/assets/apple-touch-icon.png">
  {#- menu aberto no computador até o visitante fechar uma vez (a escolha fica guardada) #}
  <script>try { if (matchMedia("(min-width: 769px)").matches && localStorage.getItem("menu") !== "fechado") document.documentElement.classList.add("menu-aberto") } catch (e) {}</script>
  {#- ?v= é a marca de versão do arquivo: sem ela o navegador segura o CSS antigo por até
      10 minutos depois de publicar. ponytail: só o CSS e o site.js são marcados; editar.js e
      as bibliotecas do editor não, então o modo de edição pode pedir recarregamento forte. -#}
  <link rel="stylesheet" href="/assets/estilo.css?v={{ "/assets/estilo.css" | versao }}">
  <script src="/assets/site.js?v={{ "/assets/site.js" | versao }}" defer></script>
</head>
<body id="topo">
  <aside class="barra">
    <a class="logo" href="/">Sidcley<br>Lyra</a>

    <nav class="pastas" aria-label="Seções">
      {%- for p in collections.paginas %}
      <a href="{{ p.url }}" data-arquivo="{{ p.inputPath | arquivo }}"{#- a seção fica marcada também nas páginas de dentro dela (/fotografias/uma-colecao/) #}{% if page.url and page.url.startsWith(p.url) %} aria-current="page"{% endif %}><span>{{ p.data.title }}</span></a>
      {%- endfor %}
    </nav>

    <div class="busca">
      <input type="search" placeholder="Buscar…" aria-label="Buscar por título ou seção">
      <ul class="resultados"></ul>
    </div>

    <button class="alternar" type="button" aria-label="Abrir ou fechar o menu"><span class="seta">◀</span><span class="hamburguer">☰</span></button>

    <footer class="redes">
      {% if site.instagram %}<a href="{{ site.instagram | urlSegura }}" aria-label="Instagram" target="_blank" rel="noopener">
        <svg viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r=".6"/></svg></a>{% endif %}
      {% if site.linkedin %}<a href="{{ site.linkedin | urlSegura }}" aria-label="LinkedIn" target="_blank" rel="noopener">
        <svg viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="3"/><path d="M8 10v7M8 7v.01M12 17v-7M12 13a3 3 0 0 1 6 0v4"/></svg></a>{% endif %}
      {% if site.email %}{% set email = site.email.split("@") %}<a href="#" class="email" data-usuario="{{ email[0] }}" data-dominio="{{ email[1] }}" aria-label="E-mail">
        <svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg></a>{% endif %}
    </footer>
  </aside>

  {#- o fundo de papel muda por seção: quadriculado, pautado ou liso #}
  <main data-papel="{{ papel | default('quadriculado') }}">
    {% include "adesivos.njk" %}
    {{ content | safe }}
  </main>

  <a class="topo" href="#topo" aria-label="Voltar ao topo">▲</a>
  <script type="application/json" id="indice-busca">{{ collections.textos | indiceBusca(collections.paginas, collections.estante) | safe }}</script>
</body>
</html>
