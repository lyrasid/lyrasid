<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if page.url != "/" %}{{ title }} · {% endif %}{{ site.nome }}</title>
  <script>try { if (matchMedia("(min-width: 769px)").matches && localStorage.getItem("menu") === "aberto") document.documentElement.classList.add("menu-aberto") } catch (e) {}</script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Narnoor:wght@400;700&family=Schoolbell&display=swap">
  <link rel="stylesheet" href="{{ '/assets/estilo.css' | url }}">
  <script src="{{ '/assets/site.js' | url }}" defer></script>
</head>
<body id="topo">
  <aside class="barra">
    <a class="logo" href="{{ '/' | url }}">Sidcley<br>Lyra</a>

    <nav class="pastas" aria-label="Seções">
      {%- for p in collections.paginas %}
      <a href="{{ p.url | url }}"{% if page.url == p.url %} aria-current="page"{% endif %}><span>{{ p.data.title }}</span></a>
      {%- endfor %}
    </nav>

    <div class="busca">
      <input type="search" placeholder="Buscar…" aria-label="Buscar por título ou seção">
      <ul class="resultados"></ul>
    </div>

    <button class="alternar" type="button" aria-label="Abrir ou fechar o menu"><span class="seta">◀</span><span class="hamburguer">☰</span></button>

    <footer class="redes">
      {% if site.instagram %}<a href="{{ site.instagram }}" aria-label="Instagram" target="_blank" rel="noopener">
        <svg viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r=".6"/></svg></a>{% endif %}
      {% if site.linkedin %}<a href="{{ site.linkedin }}" aria-label="LinkedIn" target="_blank" rel="noopener">
        <svg viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="3"/><path d="M8 10v7M8 7v.01M12 17v-7M12 13a3 3 0 0 1 6 0v4"/></svg></a>{% endif %}
      {% if site.email %}<a href="mailto:{{ site.email }}" aria-label="E-mail">
        <svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg></a>{% endif %}
    </footer>
  </aside>

  <main>
    {{ content | safe }}
    {% include "adesivos.njk" %}
  </main>

  <a class="topo" href="#topo" aria-label="Voltar ao topo">▲</a>
  <script type="application/json" id="indice-busca">{{ collections.textos | indiceBusca(collections.paginas) | safe }}</script>
</body>
</html>
