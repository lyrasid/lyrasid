{% if adesivos %}
<div class="adesivos" data-arquivo="{{ page.inputPath | arquivo }}">
  {#- o laço passa por todos para o índice bater com o arquivo (o modo de edição grava por índice) -#}
  {%- for a in adesivos %}{% if not a.oculto %}
  {%- set destino = a.link | linkDoTexto(collections.textos, collections.paginas) %}
  {#- o cadeado não aponta para um texto: leva para a área restrita #}
  {%- if a.segredo == "cadeado" %}{% set destino = "/secreto/" %}{% endif %}
  {#- sem destino o adesivo é só enfeite: vira <span>, sem virar link vazio #}
  {%- set marca = "a" if destino else "span" %}
  <{{ marca }} class="adesivo" draggable="false" data-indice="{{ loop.index0 }}"{% if a.segredo %} data-segredo="{{ a.segredo }}"{% endif %} style="--x: {{ a.x | default(80) }}%; --y: {{ a.y | default(40) }}px; --w: {{ a.largura | default(140) }}px; --r: {{ a.rotacao | default(0) }}deg"{% if destino %} href="{{ destino }}"{% endif %}>
    <img src="{{ a.imagem }}" alt="{{ a.descricao }}" draggable="false">
  </{{ marca }}>
  {%- endif %}{% endfor %}
</div>
{% endif %}
