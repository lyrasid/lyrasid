permalink: /secreto/
eleventyExcludeFromCollections: true
---
{#- Área restrita: piada interna, não um cofre. A senha é conferida no navegador,
    então qualquer pessoa curiosa consegue abrir olhando o código. Nada sigiloso aqui. -#}
<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex">
  <title>· · ·</title>
  <link rel="icon" type="image/png" sizes="32x32" href="/assets/favicon-32.png">
  <link rel="stylesheet" href="/assets/estilo.css">
  <script src="/assets/secreto.js" type="module"></script>
</head>
<body class="terminal">
  <div class="crt" aria-hidden="true"></div>

  <main class="console" aria-live="polite">
    <pre class="saida"></pre>
    <form class="linha-comando" autocomplete="off">
      <label for="entrada" class="prompt">&gt;</label>
      <input id="entrada" name="entrada" type="password" autocomplete="off" autocapitalize="off" spellcheck="false" aria-label="Digite aqui">
    </form>
  </main>

  {% if secreto.video | arquivoSeguro %}
  <video class="jumpscare" src="{{ secreto.video | arquivoSeguro }}" playsinline preload="auto"></video>
  {% endif %}

  <template id="conteudo-restrito">{{ secreto.conteudo | md | safe }}</template>
  <p class="fuga"><a href="/">sair</a></p>
</body>
</html>
